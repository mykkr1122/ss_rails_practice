# Bundler
/.bundle
/vendor/bundle

# ログ・一時ファイル
/log/*
/tmp/*
!/log/.keep
!/tmp/.keep

# 開発中のアップロード
/storage/*
!/storage/.keep

# プリコンパイル済みアセット
/public/assets
/public/packs
/public/packs-test

