/node_modules
/yarn-error.log
yarn-debug.log*
.yarn-integrity

# Rails の秘密情報（リポジトリに載せない）
/config/master.key
/config/database.yml
.env
.env.*
!.env.example

# デバッグ・レポート
.byebug_history
/coverage
brakeman_report.txt

