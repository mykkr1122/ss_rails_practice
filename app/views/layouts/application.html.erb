<!DOCTYPE html>
<html>
  <head>
    <title>SsRailsPractice</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <header class="site-header">
      <div class="site-header__inner">
        <%= link_to 'HOME', root_path, class: 'site-logo' %>
        <nav class="site-nav">
          <%= link_to '商品一覧', products_path %>
          <%= link_to '管理', admin_products_path %>
          <%= link_to "カート(#{current_cart.cart_items.sum(:quantity)})", cart_path %>
        </nav>
      </div>
    </header>

    <main class="site-main">
      <% if notice %>
        <p class="flash-notice"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="flash-alert"><%= alert %></p>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
