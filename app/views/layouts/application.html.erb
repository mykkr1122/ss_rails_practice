<!DOCTYPE html>
<html>
  <head>
    <title>SsRailsPractice</title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <div class="site-header__inner">
          <%= link_to 'HOME', root_path, class: 'site-logo' %>
          <nav class="site-nav">
            <%= link_to '商品一覧', products_path %>
            <div class="site-nav__item">
              <span class="site-nav__parent">管理</span>
              <ul class="site-nav__sub">
                <li><%= link_to '商品管理', admin_products_path %></li>
                <li><%= link_to '受注管理', admin_orders_path %></li>
              </ul>
            </div>
            <%= link_to "カート(#{current_cart&.cart_items&.sum(:quantity).to_i})", cart_path %>
            <% if unpaid_order %>
              <%= link_to "お支払い", payment_order_path(unpaid_order) %>
            <% end %>
            <% if user_signed_in? %>
              <%= link_to '注文履歴', orders_path %>
              <%= link_to '会員情報', edit_user_registration_path %>
              <%= link_to 'ログアウト', destroy_user_session_path, method: :delete %>
            <% else %>
              <%= link_to 'ログイン', new_user_session_path %>
            <% end %>
          </nav>
        </div>
      </header>
      <main class="site-main">
        <% if notice %>
          <p class="flash-notice"><%= notice %></p>
        <% end %>
        <% if alert %>
          <p class="flash-alert"><%= alert %></p>
        <% end %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
