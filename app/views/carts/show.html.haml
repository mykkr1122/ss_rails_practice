%h1 カート

- if @cart_items.blank?
  %p カートは空です
  %p= link_to '商品一覧へ', products_path
- else
  %ul
    - @cart_items.each do |item|
      %li
        %p= item.product.name
        %p= "#{item.product.price}円 × #{item.quantity}"
        %p= "小計: #{item.product.price * item.quantity}円"
        = form_with model: item, url: cart_item_path(item), method: :patch, local: true do |f|
          = f.number_field :quantity, min: 1
          = f.submit '更新'
        = button_to '削除', cart_item_path(item), method: :delete, data: { confirm: '削除しますか？' }
  %p= "合計: #{@cart_items.sum { |i| i.product.price * i.quantity }}円"
