%h1 カート

- if @cart_items.blank?
  .alert.alert-info カートは空です
  %p= link_to '商品一覧へ', products_path, class: 'btn btn-primary'
- else
  %ul.list-unstyled
    - @cart_items.each do |item|
      %li.panel.panel-default
        .panel-body
          %p= item.product.name
          %p= "SKU: #{item.sku.code}"
          %p= "#{yen(item.sku.price)} × #{item.quantity}"
          %p= "小計: #{yen(item.sku.price * item.quantity)}"
          - if item.product&.published?
            = form_with model: item, url: cart_item_path(item), method: :patch, local: true, class: 'form-inline' do |f|
              = f.number_field :quantity, min: 1, max: item.sku.stock.to_i, class: 'form-control'
              = f.submit '更新', class: 'btn btn-default'
          - else
            .alert.alert-warning この商品は現在購入できません
          = button_to '削除', cart_item_path(item), method: :delete, data: { confirm: '削除しますか？' }, class: 'btn btn-danger btn-sm'
  .price-summary
    .price-row
      %span 小計
      %span= yen(current_cart.subtotal)
    .price-row
      %span 消費税
      %span= yen(current_cart.tax)
    .price-row
      %strong 合計
      %strong= yen(current_cart.total_price)
  - if unpaid_order
    %p= link_to '未支払いの注文へ', order_payment_path(unpaid_order), class: 'btn btn-primary'
  - else
    %p= link_to '注文へ進む', new_order_path, class: 'btn btn-primary'
