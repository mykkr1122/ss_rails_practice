%h1 お支払い
%p= "注文番号: #{@order.id}"
%p= "氏名: #{@order.customer_name}"
%p= "メールアドレス: #{@order.customer_email}"
.price-summary
  .price-row
    %span 小計
    %span= yen(@order.subtotal)
  .price-row
    %span 消費税
    %span= yen(@order.tax)
  .price-row
    %strong 合計金額
    %strong= yen(@order.total_price)
%p
  決済状況:
  %span.label.label-info= t("enums.order.status.#{@order.status}")

.order-submit
  = button_to '決済する', order_payment_path(@order), method: :post, class: 'btn btn-primary'

.order-submit
  - if user_signed_in?
    %p= link_to '注文履歴へ', orders_path, class: 'btn btn-default'
  %p= link_to '商品一覧へ', products_path, class: 'btn btn-default'
