%h1 注文履歴

- if @orders.blank?
  %p 注文がありません
- else
  %table.table.table-striped
    %thead
      %tr
        %th 注文番号
        %th 注文日時
        %th 合計金額
        %th 決済状況
    %tbody
      - @orders.each do |order|
        %tr
          %td= link_to order.id, order.status_new? ? order_payment_path(order) : order_path(order)
          %td= order.created_at.strftime('%Y-%m-%d %H:%M:%S')
          %td= "#{order.total_price}円"
          %td
            %span.label.label-info= t("enums.order.status.#{order.status}")
