%h1 受注詳細

%p= "注文番号: #{@order.id}"
%p= "お名前: #{@order.customer_name}"
%p= "メールアドレス: #{@order.customer_email}"

%ul
  - @order.order_items.each do |item|
    %li
      %p= "商品名: #{item.product.name}"
      %p= "SKU: #{item.sku.code}"
      %p= "商品価格: #{item.price}円"
      %p= "商品数量: #{item.quantity}"
      %p= "商品小計: #{item.price * item.quantity}円"

%p= "注文日時: #{@order.created_at.strftime('%Y-%m-%d %H:%M:%S')}"
%p= "合計金額: #{@order.total_price}円"

%p= link_to '注文一覧へ', admin_orders_path