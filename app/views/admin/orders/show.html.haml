%h1 受注詳細

%p= "注文日時: #{@order.created_at.strftime('%Y/%m/%d %H:%M')}"
%p= "注文番号: #{@order.id}"
%p= "氏名: #{@order.customer_name}"
%p= "メールアドレス: #{@order.customer_email}"

%table.table.table-striped.table-bordered
  %thead
    %tr
      %th 商品名
      %th SKU
      %th 商品価格
      %th 商品数量
      %th 商品小計
  %tbody
    - @order.order_items.each do |item|
      %tr
        %td= item.product.name
        %td= item.sku.code
        %td= yen(item.price)
        %td= item.quantity
        %td= yen(item.price * item.quantity)

.price-summary
  .price-row
    %span 小計
    %span= yen(@order.subtotal)
  .price-row
    %span 消費税
    %span= yen(@order.tax)
  .price-row
    %strong 合計金額
    %strong= yen(@order.total_price)
%p
  決済状況:
  %span.label.label-info= t("enums.order.status.#{@order.status}")

- if @order.status_new?
  .order-submit
    = button_to '注文を完了にする', admin_order_completion_path(@order), method: :post, class: 'btn btn-primary'

.order-submit
  %p= link_to '注文一覧へ', admin_orders_path, class: 'btn btn-default'
