%h1 受注一覧
%p= link_to '商品管理へ', admin_products_path

- if @orders.blank?
  %p 注文がありません
- else 
  %ul
    - @orders.each do |order|
      %li
        %p= link_to "注文番号: #{order.id}", admin_order_path(order)
        %p= "お名前: #{order.customer_name}"
        %p= "メールアドレス: #{order.customer_email}"
        %p= "注文日時: #{order.created_at.strftime('%Y-%m-%d %H:%M:%S')}"
        %p= "合計: #{order.total_price}円"