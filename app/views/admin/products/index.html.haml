%h1 商品管理
%p= link_to '商品を登録', new_admin_product_path, class: 'btn btn-primary'

.search-panel.panel.panel-default
  .panel-body
    = search_form_for @q, url: admin_products_path do |f|
      .form-group
        = f.label :name_cont, '商品名'
        = f.search_field :name_cont, placeholder: '商品名で検索', class: 'form-control'
      .text-right
        = link_to 'クリア', admin_products_path, class: 'btn btn-default'
        = f.submit '検索', class: 'btn btn-primary'

- if @products.blank?
  %p 商品がありません。
- else
  %ul.product-list
    - @products.each do |product|
      %li.product-card.panel.panel-default
        = link_to product.name, admin_product_path(product), class: 'product-card__name'
        %p.product-card__price
          = product.display_price
          円〜
        %p
          = link_to '編集', edit_admin_product_path(product), class: 'btn btn-default btn-sm'
