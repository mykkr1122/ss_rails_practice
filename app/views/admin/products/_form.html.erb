<% if product.errors.any? %>
  <div id="error_explanation">
    <h2><%= product.errors.count %> 件のエラーがあります。</h2>
    <ul>
      <% product.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
<%= form_with model: [:admin,product], local: true do |form| %>
  <p>
    <%= form.label :name, '商品名' %><br>
    <%= form.text_field :name %>
  </p>
  <p>
    <%= form.label :store_id, '店舗' %><br>
    <%= form.collection_select :store_id, Store.order(:store_number), :id, :label_for_select, include_blank: true %>
  </p>
  <p>
    <%= form.label :description, '説明' %><br>
    <%= form.text_area :description %>
  </p>
  <table>
    <thead>
      <tr>
        <th>SKUコード</th>
        <th>価格</th>
        <th>在庫</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <%= form.fields_for :skus do |sku_form| %>
        <tr>
          <td>
            <%= sku_form.hidden_field :id %>
            <%= sku_form.text_field :code %>
          </td>
          <td><%= sku_form.number_field :price %></td>
          <td><%= sku_form.number_field :stock %></td>
          <td>
            <% if sku_form.object.persisted? %>
              <%= sku_form.check_box :_destroy %>
              <%= sku_form.label :_destroy, '削除' %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <p>
    <%= form.label :status, '状態' %><br>
    <%= form.select :status, [['公開', 'published'], ['非公開', 'hidden']] %>
  </p>
  <p>
    <%= form.submit(product.persisted? ? '更新する' : '登録する') %>
  </p>
<% end %>
