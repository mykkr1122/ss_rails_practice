<h1>商品管理</h1>
<p><%= link_to '商品を登録', new_admin_product_path %></p>

<%= search_form_for @q, url: admin_products_path, class: 'search-form' do |f| %>
  <%= f.search_field :name_cont, placeholder: '商品名で検索' %>
  <%= f.submit '検索' %>
<% end %>

<% if @products.blank? %>
  <p>商品がありません。</p>
<% else %>
  <ul class="product-list">
    <% @products.each do |product| %>
      <li class="product-card">
        <%= link_to product.name, admin_product_path(product), class: 'product-card__name' %>
        <p class="product-card__price"><%= product.display_price %>円〜</p>
        <p>
          <%= link_to '編集', edit_admin_product_path(product) %>
        </p>
      </li>
    <% end %>
  </ul>
<% end %>