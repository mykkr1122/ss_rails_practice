<section class="page-hero">
  <h1>商品一覧</h1>

  <%= search_form_for @q, url: products_path, class: 'search-form' do |f| %>
    <%= f.search_field :name_cont, placeholder: '商品名で検索' %>
    <%= f.submit '検索' %>
  <% end %>
</section>

<% if @products.blank? %>
  <p>商品がありません。</p>
<% else %>
  <ul class="product-list">
    <% @products.each do |product| %>
      <li class="product-card">
        <%= link_to product.name, product_path(product), class: 'product-card__name' %>
        <% if product.sold_out? %>
          <p class="product-card__sold-out">売り切れ</p>
        <% else %>
          <p class="product-card__price"><%= product.display_price %>円〜</p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
