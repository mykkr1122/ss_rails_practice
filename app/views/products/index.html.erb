<section class="page-hero">
  <h1>商品一覧</h1>

  <%= form_with url: products_path, method: :get, local: true, class: 'search-form' do %>
    <%= text_field_tag :q, params[:q], placeholder: '商品名で検索' %>
    <%= submit_tag '検索' %>
  <% end %>
</section>

<% if @products.blank? %>
  <p>商品がありません。<%= link_to '新規登録', new_product_path %>から追加してください。</p>
<% else %>
  <ul class="product-list">
    <% @products.each do |product| %>
      <li class="product-card">
        <%= link_to product.name, product_path(product), class: 'product-card__name' %>
        <p class="product-card__price"><%= product.price %>円</p>
        <p>
          <%= link_to '詳細', product_path(product) %>
        </p>
      </li>
    <% end %>
  </ul>
<% end %>
