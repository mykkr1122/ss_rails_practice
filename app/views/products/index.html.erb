<section class="page-hero">
  <h1>商品一覧</h1>

  <%= form_with url: products_path, method: :get, local: true, class: 'search-form' do %>
    <%= text_field_tag :q, params[:q], placeholder: '商品名で検索' %>
    <%= submit_tag '検索' %>
  <% end %>
</section>

<% if @products.blank? %>
  <p>商品がありません。</p>
<% else %>
  <ul class="product-list">
    <% @products.each do |product| %>
      <li class="product-card">
        <%= link_to product.name, product_path(product), class: 'product-card__name' %>
        <% if product.sold_out %>
          <p class="product-card__sold-out">売り切れ</p>
        <% else %>
          <p class="product-card__price"><%= product.display_price %>円〜</p>
        <% end %>
      </li>
    <% end %>
  </ul>
<% end %>
