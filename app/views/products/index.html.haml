%section.page-hero
  %h1 商品一覧
  = search_form_for @q, url: products_path, class: 'search-form form-inline' do |f|
    = f.search_field :name_cont, placeholder: '商品名で検索', class: 'form-control'
    = f.submit '検索', class: 'btn btn-default'
- if @products.blank?
  %p 商品がありません。
- else
  %ul.product-list
    - @products.each do |product|
      %li.product-card.panel.panel-default
        = link_to product.name, product_path(product), class: 'product-card__name'
        - if product.sold_out?
          %p.product-card__sold-out
            %span.label.label-default 売り切れ
        - else
          %p.product-card__price
            = product.display_price
            円〜
