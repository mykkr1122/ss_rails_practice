<%= form_with model: product, local: true do |form| %>
  <p>
    <%= form.label :name, '商品名' %><br>
    <%= form.text_field :name %>
  </p>
  <p>
    <%= form.label :price, '価格' %><br>
    <%= form.number_field :price %>
  </p>
  <p>
    <%= form.submit(product.persisted? ? '更新する' : '登録する') %>
  </p>
<% end %>
