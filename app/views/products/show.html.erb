<article class="product-detail">
  <h1><%= @product.name %></h1>
  <p><%= simple_format(@product.description) %></p>
  <% if @product.skus.blank? || @product.sold_out? %>
    <p>売り切れました。</p>
  <% else %>
    <%= form_with model: CartItem.new, url: cart_items_path, local: true do |f| %>
      <%= hidden_field_tag :product_id, @product.id %>
      <p>
        <%= f.label :sku_id, 'SKU' %>
        <%= f.select :sku_id,
                     options_for_select(
                       @product.skus.map { |s|
                         label = s.stock.to_i <= 0 ? "#{s.code_with_price}(売り切れ)" : s.code_with_price
                         [label, s.id, { disabled: s.stock.to_i <= 0 }]
                       }
                     ),
                     { include_blank: '選択してください' } %>
        <%= f.label :quantity, '数量' %>
        <%= f.number_field :quantity, value: 1, min: 1 %>
      </p>
      <p>
        <%= f.submit 'カートに追加' %>
      </p>
    <% end %>
  <% end %>
  <p>
    <%= link_to '一覧へ', products_path %>
  </p>
</article>
