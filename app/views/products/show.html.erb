<article class="product-detail">
  <h1><%= @product.name %></h1>
  <p><%= simple_format(@product.description) %></p>
  <p class="product-card__price"><%= @product.price %>円</p>


  <%= form_with model: CartItem.new, url: cart_items_path, local: true do |f| %>
    <%= f.hidden_field :product_id, value: @product.id %>
    <p>
      <%= f.label :quantity, '数量' %>
      <%= f.number_field :quantity, value: 1, min: 1, max: 10 %>
    </p>
    <p>
        <%= f.submit 'カートに追加' %>
    </p>
  <% end %>
  <p>
    <%= link_to '一覧へ', products_path %>
  </p>
</article>
